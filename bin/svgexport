// Renders a CPEE model or testset to a standalone SVG, the same way the cockpit
// exports it (get_svg in wfadaptor.js).

'use strict';

const fs = require('fs');
const { parse_args, render, write, run, FONT } = require('../lib/render.js');

const SVGNS = 'http://www.w3.org/2000/svg';

run('svgexport', async () => {
  const opts = parse_args(process.argv.slice(2),
    'Usage: svgexport [-lr] [-o FILE] [--embed-font] MODEL|TESTSET\n' +
    '\n' +
    '  MODEL|TESTSET   CPEE model (<description>) or testset (its <description> is used)\n' +
    '  -lr             use the presetlr theme (left to right) instead of preset\n' +
    '  -o FILE         write the SVG to FILE instead of stdout\n' +
    '  --embed-font    embed AdwaitaSans-Regular.ttf, otherwise the font has to be installed\n',
    { '--embed-font': 'embed_font' }
  );
  const { window, $, graphrealization } = await render(opts.input, opts.theme);

  const svg = graphrealization.get_svg();
  if (opts.embed_font) {
    const style = window.document.createElementNS(SVGNS, 'style');
    style.textContent = "@font-face { font-family: 'Adwaita Sans'; src: url(data:font/ttf;base64," + fs.readFileSync(FONT).toString('base64') + '); }';
    svg.insertBefore(style, svg.firstChild);
  }
  write(opts, '<?xml version="1.0" encoding="UTF-8"?>\n' + $(svg).serializePrettyXML() + '\n');
  window.close();
});
