// Prints the layout of a CPEE model or testset as JSON (get_svg_metrics in
// wfadaptor.js): pos_matrix holds the symbols per row and column, con_list the
// connections between them.

'use strict';

const { parse_args, render, write, run } = require('../lib/render.js');

run('svgmetrics', async () => {
  const opts = parse_args(process.argv.slice(2),
    'Usage: svgmetrics [-lr] [-o FILE] MODEL|TESTSET\n' +
    '\n' +
    '  MODEL|TESTSET   CPEE model (<description>) or testset (its <description> is used)\n' +
    '  -lr             use the presetlr theme (left to right) instead of preset\n' +
    '  -o FILE         write the JSON to FILE instead of stdout\n'
  );
  const { window, graphrealization } = await render(opts.input, opts.theme);

  write(opts, JSON.stringify(graphrealization.get_svg_metrics(), null, 2) + '\n');
  window.close();
});
